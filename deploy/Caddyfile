quran.host, www.quran.host {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}

	root * /home/httpserver/private/quran.host/www
	header /audio/* {
		Cache-Control "public, max-age=31536000, immutable"
		Access-Control-Allow-Origin *
	}
	file_server {
		hide *.part
	}

	tls {
		import tls
	}
}
